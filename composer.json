{
    "name": "carpool-logistics/telnyx-php",
    "description": "Telnyx PHP Library",
    "keywords": [
        "telnyx",
        "api"
    ],
    "homepage": "https://telnyx.com/",
    "license": "MIT",
    "authors": [
        {
            "name": "Telnyx and contributors",
            "homepage": "https://github.com/telnyx/telnyx-php/contributors"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0",
        "squizlabs/php_codesniffer": "^3.3",
        "symfony/process": "^6.0|^7.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": { "Telnyx\\": "lib/" }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover build/logs/clover.xml",
        "cs-check": "phpcs"
    },
    "config": {
        "sort-packages": true
    }
}
